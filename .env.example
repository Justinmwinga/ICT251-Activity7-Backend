# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string.
# Render: use the "External Database URL" when running locally,
#         and the "Internal Database URL" in the Render web service settings.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Set to "false" only for a local Postgres without SSL.
# (SSL is turned on automatically for every host except localhost.)
# DATABASE_SSL=false

# Frontend origins allowed to call this API from a browser (comma separated,
# scheme + host + port, no path and no final slash).
# Activity 8: add your Netlify site, e.g. https://your-final-site.netlify.app
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional: the public address shown on the API guide page.
# PUBLIC_URL=https://your-backend.onrender.com

# Render sets PORT itself. Locally it defaults to 3000.
# PORT=3000
